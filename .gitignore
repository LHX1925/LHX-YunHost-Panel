# 运行时目录
/runtime/

# 安装锁文件（防止泄露安装状态）
/install.lock

# 上传目录
/public/static/captcha/
/public/static/images/
/public/static/img/
/public/uploads/

# 数据库配置文件（包含敏感信息）
/app/database.php

# 应用配置文件（可能包含敏感信息）
/app/config.php

# 用户文件
.DS_Store
Thumbs.db
*.log
*.sql

# IDE
.idea/
.vscode/
*.swp
*.swo

# 依赖
/vendor/
/node_modules/

# 临时文件
*.tmp
*.bak